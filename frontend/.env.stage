# Stage demo defaults.
#
# This file intentionally contains only non-sensitive values. Put demo wallet
# keys and stage contract addresses in .env.stage.local, which is gitignored.

VITE_CHAIN_A_ID=100003
VITE_CHAIN_B_ID=200005
VITE_FLASHBLOCKS_ENABLED=true

VITE_CHAIN_A_BUILDER_RPC=https://op-rbuilder-a.stage.ethera-labs.io
VITE_CHAIN_A_OP_RETH_RPC=https://rpc-a.stage.ethera-labs.io
VITE_CHAIN_B_BUILDER_RPC=https://op-rbuilder-b.stage.ethera-labs.io
VITE_CHAIN_B_OP_RETH_RPC=https://rpc-b.stage.ethera-labs.io

VITE_SIDECAR_A_URL=https://sepolia-sidecar-a.stage.vnet.ops.ssvlabsinternal.com
VITE_SIDECAR_B_URL=https://sepolia-sidecar-b.stage.vnet.ops.ssvlabsinternal.com

VITE_CHAIN_A_BLOCKSCOUT_URL=https://rollup-a.explorer.stage.ethera-labs.io
VITE_CHAIN_B_BLOCKSCOUT_URL=https://rollup-b.explorer.stage.ethera-labs.io

# localnet-health is not part of the stage demo path.
VITE_HEALTH_API_URL=

# From contracts@origin/develop.
VITE_CHAIN_A_BRIDGE_ADDRESS=0x6e166073b5dd5fd53b33fed5a7bd9c104c6c6ebd
VITE_CHAIN_B_BRIDGE_ADDRESS=0x6e166073b5dd5fd53b33fed5a7bd9c104c6c6ebd

# Stage Test Token. The same address exists on both rollups; wrapped/CET token
# addresses are derived by VITE_CET_FACTORY_ADDRESS.
VITE_CHAIN_A_TOKEN_ADDRESS=0xc5AE941FE1958e915dCc42531DA5B29AB2e3EA5B
VITE_CHAIN_B_TOKEN_ADDRESS=0xc5AE941FE1958e915dCc42531DA5B29AB2e3EA5B

VITE_CET_FACTORY_ADDRESS=0x552e0fc7105bd628e507ead8973694cf559ad27e
VITE_CHAIN_A_ETH_LIQUIDITY_ADDRESS=0x053402b5adfa240fe999a5080121ce53b51fa2c1
VITE_CHAIN_B_ETH_LIQUIDITY_ADDRESS=0x053402b5adfa240fe999a5080121ce53b51fa2c1

# Never commit a real key here. Use a throwaway funded demo key in
# .env.stage.local.
VITE_WALLET_PRIVATE_KEY=
